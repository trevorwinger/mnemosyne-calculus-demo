# Copy to .env; never commit real production credentials.
POSTGRES_DB=office_hours
POSTGRES_USER=office_hours
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://office_hours:change-me-before-production@db:5432/office_hours
APP_ENV=development
DEMO_MODE=true
WEB_ORIGIN=http://localhost:3000
OLLAMA_BASE_URL=http://host.docker.internal:11434
# bootstrap-demo.sh sets this to gemma4:12b for a live local tutor.
PROTOTYPE_DEFAULT_MODEL=demo-tutor
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=26
MAX_CONTEXT_CHARS=18000
MAX_MODEL_CONCURRENCY=1
OLLAMA_TIMEOUT_SECONDS=60
# Set to 0 to disable local development throttling.
REQUEST_LIMIT_PER_WINDOW=120
REQUEST_LIMIT_WINDOW_SECONDS=60
# Java code labs execute only in the isolated local runner container.
CODE_EXECUTION_ENABLED=true
CODE_RUNNER_SOCKET=/runner/java-runner.sock
